# Copy to .env and fill in. .env is gitignored — never commit real tokens.
#
# Admin API access tokens (shpat_...) from a custom app.
# Create one at: Shopify Admin → Settings → Apps and sales channels →
# Develop apps → Create an app → Configure Admin API scopes → Install app →
# API credentials → reveal the "Admin API access token".
#
# scripts/*.sh read SHOPIFY_ADMIN_TOKEN + SHOPIFY_STORE directly, so before
# running one against a given store:
#   set -a; source .env; set +a
#   SHOPIFY_ADMIN_TOKEN="$SHOPIFY_ADMIN_TOKEN_DEV" SHOPIFY_STORE=lms-sandbox-lutsfahz.myshopify.com ./scripts/whatever.sh
# or for production:
#   SHOPIFY_ADMIN_TOKEN="$SHOPIFY_ADMIN_TOKEN_PROD" SHOPIFY_STORE=p0wkgv-wy.myshopify.com ./scripts/whatever.sh

# lms-sandbox-lutsfahz.myshopify.com
SHOPIFY_ADMIN_TOKEN_DEV=

# p0wkgv-wy.myshopify.com
SHOPIFY_ADMIN_TOKEN_PROD=
