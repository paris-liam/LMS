{
  "sections": {
    "main": {
      "type": "main-movie",
      "settings": {}
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "product": "{{ product }}",
        "recommendation_type": "related",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 24,
        "rows_gap": 28,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 22,
        "padding-block-start": 8,
        "padding-block-end": 48
      },
      "blocks": {
        "header": {
          "type": "text",
          "settings": {
            "text": "<span class=\"lms-eyebrow\">From the same shelf</span><h2 class=\"lms-movie-recs__heading\">Pairs well with</h2>",
            "width": "100%",
            "max_width": "none",
            "alignment": "left",
            "type_preset": "rte"
          }
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 4
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "portrait",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 4,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": ["product-card-gallery", "product_title"]
        }
      },
      "block_order": ["header"]
    }
  },
  "order": ["main", "recommendations"]
}
