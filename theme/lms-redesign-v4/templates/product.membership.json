                "custom_liquid": "{% liquid\n  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id\n  assign checkbox_id = 'TermsAgreement-' | append: closest.product.id\n%}\n<div\n  class=\"spacing-style\"\n  style=\"--padding-block-start: 12px;--padding-block-end: 0px;--padding-inline-start: 0px;--padding-inline-end: 0px;\"\n>\n  {% render 'checkbox',\n    name: 'properties[Term Agreement]',\n    value: 'Yes',\n    label: 'I agree to the Membership Terms',\n    id: checkbox_id,\n    checked: false,\n    events: '',\n    disabled: false,\n    required: true,\n    formId: product_form_id\n  %}\n</div>"
