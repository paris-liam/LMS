            "membership_page_scripts_7kLp3W": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{% liquid\n  assign membership_variant = closest.product.selected_or_first_available_variant\n  assign already_in_cart_qty = cart | item_count_for_variant: membership_variant.id\n  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id\n%}\n<style>\n  .shopify_subscriptions_app_container {\n    display: none !important;\n  }\n  .product-details .quantity-selector-wrapper {\n    display: none !important;\n  }\n  .lms-already-in-cart-note {\n    font-size: var(--font-size--sm);\n    margin: 0 0 var(--padding-sm);\n  }\n  product-custom-property-component .__character-label {\n    display: none;\n  }\n  product-custom-property-component .__input-wrapper input {\n    padding: var(--input-padding);\n  }\n</style>\n<script>\n  (function () {\n    var alreadyInCart = {{ already_in_cart_qty | default: 0 }} > 0;\n\n    function forceAnnualSellingPlan() {\n      var container = document.querySelector('.shopify_subscriptions_app_container');\n      if (!container) return;\n      var annualRadio = container.querySelector('input[data-radio-type=\"selling_plan\"]');\n      if (!annualRadio || annualRadio.checked) return;\n      var oneTimeRadio = container.querySelector('input[data-radio-type=\"one_time_purchase\"]');\n      if (oneTimeRadio) oneTimeRadio.checked = false;\n      annualRadio.checked = true;\n      annualRadio.dispatchEvent(new Event('change', { bubbles: true }));\n      annualRadio.dispatchEvent(new Event('click', { bubbles: true }));\n    }\n    if (document.readyState === 'complete') {\n      forceAnnualSellingPlan();\n    } else {\n      window.addEventListener('load', forceAnnualSellingPlan);\n    }\n\n    // The Add to cart button already refuses to submit an invalid form, but\n    // silently - no native validation bubble is shown. Surface one on click.\n    function reportTermsValidity(form) {\n      if (form && !form.checkValidity()) {\n        form.reportValidity();\n      }\n    }\n\n    // Dynamic checkout / \"More payment options\" is a separate web component\n    // that does NOT consult the product form's validity (verified empirically:\n    // it navigates straight to Shopify checkout even with the terms checkbox\n    // unchecked). Hide it until the checkbox is checked instead of relying on\n    // native form validation to cover it.\n    function updateAcceleratedCheckoutVisibility(checkbox) {\n      var accelerated = document.querySelector('.accelerated-checkout-block');\n      if (!accelerated) return;\n      var shouldShow = !alreadyInCart && !!(checkbox && checkbox.checked);\n      accelerated.toggleAttribute('hidden', !shouldShow);\n    }\n\n    document.addEventListener('DOMContentLoaded', function () {\n      var form = document.getElementById('{{ product_form_id }}');\n      var checkbox = document.querySelector('input[name=\"properties[Term Agreement]\"]');\n\n      updateAcceleratedCheckoutVisibility(checkbox);\n      if (checkbox) {\n        checkbox.addEventListener('change', function () {\n          updateAcceleratedCheckoutVisibility(checkbox);\n        });\n      }\n\n      document.querySelectorAll('.add-to-cart-button').forEach(function (button) {\n        button.addEventListener('click', function () {\n          reportTermsValidity(form);\n        });\n      });\n\n      var birthdayInput = document.querySelector('input[name=\"properties[Birthday]\"]');\n      if (birthdayInput) {\n        birthdayInput.setAttribute('inputmode', 'numeric');\n        birthdayInput.setAttribute('autocomplete', 'off');\n        birthdayInput.addEventListener('input', function () {\n          var cursor = birthdayInput.selectionStart;\n          var digitsBeforeCursor = birthdayInput.value.slice(0, cursor).replace(/\\D/g, '').length;\n\n          var digits = birthdayInput.value.replace(/\\D/g, '').slice(0, 4);\n          var formatted = digits.length > 2 ? digits.slice(0, 2) + '/' + digits.slice(2) : digits;\n          birthdayInput.value = formatted;\n\n          var newCursor = digitsBeforeCursor + (digitsBeforeCursor > 2 ? 1 : 0);\n          birthdayInput.setSelectionRange(newCursor, newCursor);\n        });\n      }\n\n      if (alreadyInCart) {\n        document.querySelectorAll('.add-to-cart-button').forEach(function (button) {\n          button.disabled = true;\n        });\n        var buyButtons = document.querySelector('.buy-buttons-block');\n        if (buyButtons && buyButtons.parentNode) {\n          var note = document.createElement('p');\n          note.className = 'lms-already-in-cart-note';\n          note.innerHTML = 'You already have a membership in your cart - <a href=\"/cart\">view cart</a>.';\n          buyButtons.parentNode.insertBefore(note, buyButtons);\n        }\n      }\n    });\n  })();\n</script>"
              }
            }
