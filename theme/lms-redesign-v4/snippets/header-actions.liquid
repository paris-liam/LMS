{% doc %}
  Header Actions Component

  Renders the header actions.

  @param {object} [section] - The section object providing settings such as actions_font.
  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [display_style] - Controls display mode for header actions: 'icon' or 'text'.

  @example
  {% render 'header-actions', section: section %}
{% enddoc %}

<header-actions
  {% if display_style == 'text' %}
    class="header-actions--text"
  {% endif %}
  {{- block.shopify_attributes -}}
>
  <a
    href="{{ section.settings.join_club_url | default: '/pages/membership' }}"
    class="lms-btn lms-btn--primary lms-btn--sm header-actions__action header-actions__join-club{% if display_style == 'text' %} header-actions__text-style{% endif %}"
  >
    {{ section.settings.join_club_label | default: 'Join the Club' }}
  </a>

</header-actions>

{% stylesheet %}
  header-actions {
    display: flex;
    align-items: center;

    @media screen and (max-width: 749px) {
      justify-self: flex-end;
    }
  }

  .header-actions__join-club {
    margin-inline-start: var(--gap-md);
    white-space: nowrap;
  }

  /* Keep the pill's own light text; the header forces --color-foreground on actions. */
  header-actions .header-actions__join-club,
  header-actions .header-actions__join-club:hover {
    color: #fff;
  }

  /* On mobile the pill would crowd the compact bar; the drawer carries the link instead. */
  @media screen and (max-width: 749px) {
    .header-actions__join-club {
      display: none;
    }
  }

  #header-component[data-menu-style='drawer'] .header-actions__join-club {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header-actions--text {
      gap: var(--gap-xl);
    }

    .header-actions__text-style {
      font-size: var(--header-actions-font-size);
      font-family: var(--header-actions-font-family);
      font-weight: var(--header-actions-font-weight);
      text-transform: var(--header-actions-text-case);
    }
  }

  #header-component[data-menu-style='drawer'] header-actions {
    justify-self: flex-end;
  }

  .header__column--right header-actions {
    margin-inline-start: calc(var(--gap-md) * -1);
  }

  .header-actions__text {
    display: flex;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .header__column--right .header-actions--text {
      margin-inline-start: 0;
    }
  }
{% endstylesheet %}
