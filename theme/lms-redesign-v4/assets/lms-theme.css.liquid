{% comment %}
  ============================================================================
  Little Movie Store — Layer 2 residual token overrides for Horizon 4.0
  ----------------------------------------------------------------------------
  Only the things Horizon's theme settings (Layer 1, settings_data.json) can't
  express: self-hosted fonts, warm-tinted shadows, the signature eyebrow, the
  cyan accent, warm-white cards.

  This is a *.css.liquid* asset so {{ ... | asset_url }} resolves the
  self-hosted font files. Shopify compiles it to `lms-theme.css`.

  LOAD ORDER — must come AFTER color-palette. In layout/theme.liquid <head>,
  immediately after `{%- render 'color-palette' -%}`, add ONE line:

      {{ 'lms-theme.css' | asset_url | stylesheet_tag }}

  That single include is the only sanctioned vendor-file edit. Logged in
  shopify/changes.md.
  ============================================================================
{% endcomment %}

/* NOTE: this is a Liquid-compiled CSS asset — do NOT wrap it in the Liquid
   style/endstyle tag pair: that tag emits literal HTML style-element tags
   (and Liquid runs even inside CSS comments), which would invalidate the file. */
:root {
    /* --- Raw brand palette: single source of truth (mirrors Layer 1) --- */
    --lms-brick: #973123;
    --lms-brick-dark: #6f2417;
    --lms-mahogany: #3a2018;
    --lms-sage: #5f8d7a;
    --lms-hunter: #343a31;
    --lms-parchment: #fff9ef;
    --lms-parchment-2: #fdf3e2;
    --lms-parchment-edge: #f3e7d0;
    --lms-cyan: #8fcdcf;
    --lms-surface-card: #ffffff; /* warm-white card, distinct from parchment page */

    /* --- Fonts: self-hosted (see @font-face below). Override Horizon's
           picker-driven family vars. Graceful fallback stack means pages still
           read well before the WOFF2 files are uploaded. --- */
    --font-heading--family: "Epilogue", "Work Sans", system-ui, sans-serif;
    --font-accent--family: "Epilogue", "Work Sans", system-ui, sans-serif;
    --font-body--family: "DM Mono", ui-monospace, "SFMono-Regular", monospace;
    --font-subheading--family: "DM Mono", ui-monospace, "SFMono-Regular", monospace;

    /* --- Warm-tinted shadows (Horizon's defaults are neutral/black) --- */
    --shadow-button: 0 2px 3px rgba(58, 32, 24, 0.18);
    --shadow-drawer: 0 16px 40px rgba(58, 32, 24, 0.16);
    --shadow-popover: 0 6px 18px rgba(58, 32, 24, 0.12);

    /* --- Type scale: PIN exact brand sizes/leading here. Horizon's
           type_size_* / type_line_height_* selects only allow fixed options
           (…16,20,24,32…) and display-*/heading-* leading — our 30/25/17/15/13
           and 1.18 leading are off-menu, so the editor would snap Layer 1 to
           nearest-legal on first save. These overrides are the source of truth;
           Layer 1 just carries a close legal fallback. --- */
    --font-h1--size: 1.875rem;  --font-h1--line-height: 1.15; /* 30px */
    --font-h2--size: 1.5625rem; --font-h2--line-height: 1.15; /* 25px */
    --font-h3--size: 1.25rem;   --font-h3--line-height: 1.2;  /* 20px */
    --font-h4--size: 1.0625rem; --font-h4--line-height: 1.25; /* 17px */
    --font-h5--size: 0.9375rem; --font-h5--line-height: 1.3;  /* 15px */
    --font-h6--size: 0.8125rem; --font-h6--line-height: 1.3;  /* 13px */

    /* --- Optional: force LMS 1200px container instead of Horizon 'narrow'
           (1440px). Uncomment to enable. (Open question §9 Q3.) --- */
    /* --narrow-page-width: 75rem; */
  }

  /* Signature eyebrow — DM Mono Medium, wide-tracked, uppercase, brick.
     Use as <span class="lms-eyebrow">Now showing</span>. */
  .lms-eyebrow {
    font-family: var(--font-subheading--family);
    font-weight: 500;
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lms-brick);
  }

  ::selection {
    background: var(--lms-cyan);
    color: var(--lms-mahogany);
  }

  /* ==========================================================================
     SELF-HOSTED FONTS
     Activates automatically once these WOFF2 files are added to assets/:
       epilogue-500.woff2      (headings; brand rule: never > Medium/500)
       epilogue-400.woff2      (optional — add the @font-face if any UI needs it)
       epilogue-600.woff2      (optional)
       dm-mono-300.woff2       (body / light)
       dm-mono-400.woff2       (regular)
       dm-mono-500.woff2       (eyebrow / medium)
     Until then, the fallback stack above (Work Sans / system mono) renders.
     ========================================================================== */
  @font-face {
    font-family: "Epilogue";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'epilogue-500.woff2' | asset_url }}") format("woff2");
  }
  /* Optional Epilogue weights — uncomment to use the uploaded 400/600 files
     (else remove those files so they aren't dead weight). Brand rule: headings
     never exceed Medium/500, so 600 is for non-heading UI only. */
  /* @font-face {
    font-family: "Epilogue"; font-style: normal; font-weight: 400; font-display: swap;
    src: url("{{ 'epilogue-400.woff2' | asset_url }}") format("woff2");
  }
  @font-face {
    font-family: "Epilogue"; font-style: normal; font-weight: 600; font-display: swap;
    src: url("{{ 'epilogue-600.woff2' | asset_url }}") format("woff2");
  } */
  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 300;
    font-display: swap;
    src: url("{{ 'dm-mono-300.woff2' | asset_url }}") format("woff2");
  }
  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'dm-mono-400.woff2' | asset_url }}") format("woff2");
  }
  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'dm-mono-500.woff2' | asset_url }}") format("woff2");
  }
