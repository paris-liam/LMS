{%- doc -%}
  Renderless utility block: loads the script that redirects straight to
  checkout after a successful add-to-cart, skipping the cart drawer/page.
  Only included when a parent buy-buttons block enables it — see
  block_settings.enable_checkout_redirect in blocks/buy-buttons.liquid.
{%- enddoc -%}
<script
  src="{{ 'membership-checkout-redirect.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% schema %}
{
  "name": "Checkout redirect",
  "tag": null
}
{% endschema %}
