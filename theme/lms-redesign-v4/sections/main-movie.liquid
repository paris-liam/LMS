{% comment %}
  main-movie — dedicated read-only PDP for rental/movie products.
  Spec: docs/superpowers/specs/2026-07-17-movie-product-template-design.md
  Redesign pass (2026-09-03): restyled toward docs/product-a.dc.html mockup —
  breadcrumb, badges above title, 3:4 poster with stylized fallback, "About
  the film" label, related-products rail (see templates/product.movie.json).
  Availability label restored (2026-09-03) reading supercycle.* metafields;
  notify-me is still removed — see git history if it needs to come back.
  NO price / variant / add-to-cart / dynamic checkout / Supercycle Methods
  slot — all transactions are in-store.
{% endcomment %}

{%- liquid
  # .first does not work on this list-of-metaobjects drop — only iteration does.
  assign genre_label = ''
  assign genre_handle = ''
  for genre_item in product.metafields.shopify.genre.value limit: 1
    assign genre_label = genre_item.label
    assign genre_handle = genre_item.system.handle
  endfor
  # Media format lives in product.vendor, not a metafield — see
  # claudedocs/2026-08-07-product-data-model-audit.md. The matching facet is
  # the built-in "Product vendor" filter in Search & Discovery. Only chip
  # recognised formats so a stray vendor name never renders as a format.
  # The recognised-format list is a theme setting so a new format needs no
  # code change. Falls back to the built-in list when the setting is blank,
  # so clearing it can never blank every badge on the storefront.
  # Each entry is stripped individually rather than by removing all spaces:
  # the setting is merchant-edited, so "VHS ,DVD" or a trailing space must
  # still match, while genuinely multi-word formats like "4K UHD" survive.
  assign format_setting = settings.lms_known_formats | default: 'VHS,DVD,BLU-RAY,4K,LASERDISC,BETAMAX'
  assign format_parts = format_setting | upcase | split: ','
  assign known_formats = ''
  for format_part in format_parts
    assign format_trimmed = format_part | strip
    if format_trimmed != blank
      assign known_formats = known_formats | append: format_trimmed | append: ','
    endif
  endfor
  assign known_formats = known_formats | split: ','
  assign vendor_upcase = product.vendor | upcase
  assign format_label = ''
  if known_formats contains vendor_upcase
    assign format_label = product.vendor
  endif

  # STAND-IN NOTE: reading Supercycle-owned metafields, do not create the namespace.
  assign sc_enabled = product.metafields.supercycle.supercycle_enabled
  assign movie_available = true
  assign movie_label = 'Available in-store'
  if sc_enabled == true
    assign sc_variant = product.selected_or_first_available_variant
    # A boolean metafield unwraps to a plain true/false, so an absent metafield
    # (nil) and a genuine false are both falsy. Treating them alike made a
    # half-synced product render "Currently out" when it has no data at all.
    # uncommitted_inventory_count is the presence probe: `default` replaces nil
    # but leaves a real 0 intact, so -1 means "no availability data".
    # `== blank` cannot be used for this — in Liquid, `false == blank` is true.
    assign sc_count = sc_variant.metafields.supercycle.uncommitted_inventory_count | default: -1
    assign sc_uncommitted = sc_variant.metafields.supercycle.uncommitted_inventory
    if sc_count >= 0
      if sc_uncommitted
        assign movie_label = 'Available now'
      else
        assign movie_available = false
        assign movie_label = 'Currently out'
      endif
    endif
  endif
-%}

<section class="lms-movie lms-container">
  {% # theme-check-disable HardcodedRoutes %}
  <div class="lms-movie__breadcrumb">
    <a href="/collections/all-movies">← Back to the shelves</a>
    <span aria-hidden="true">·</span>
    {%- if genre_label != blank -%}
      <a href="/collections/all-movies">All Movies</a>
      <span aria-hidden="true">/</span>
      <a href="/collections/all-movies?filter.p.m.shopify.genre={{ genre_handle | url_encode }}">{{ genre_label }}</a>
    {%- else -%}
      <a href="/collections/all-movies">All Movies</a>
    {%- endif -%}
  </div>
  {% # theme-check-enable HardcodedRoutes %}

  <div class="lms-movie__grid">
    <div class="lms-movie__media">
      {%- if product.featured_image -%}
        {{ product.featured_image
          | image_url: width: 900
          | image_tag:
            widths: '450, 675, 900',
            sizes: '(max-width: 749px) 100vw, 45vw',
            loading: 'eager',
            alt: product.featured_image.alt | default: product.title }}
      {%- else -%}
        <div class="lms-movie__placeholder">
          <span class="lms-movie__placeholder-title">{{ product.title }}</span>
          <span class="lms-movie__placeholder-caption">Cover art coming soon</span>
        </div>
      {%- endif -%}
    </div>

    <div class="lms-movie__details">
      {%- if genre_label != blank or format_label != blank -%}
        {% # theme-check-disable HardcodedRoutes %}
        <div class="lms-movie__chips">
          {%- if genre_label != blank -%}
            <a class="lms-badge lms-badge--muted" href="/collections/all-movies?filter.p.m.shopify.genre={{ genre_handle | url_encode }}">{{ genre_label }}</a>
          {%- endif -%}
          {%- if format_label != blank -%}
            <a class="lms-badge lms-badge--muted" href="/collections/all-movies?filter.p.vendor={{ format_label | url_encode }}">{{ format_label }}</a>
          {%- endif -%}
        </div>
        {% # theme-check-enable HardcodedRoutes %}
      {%- endif -%}

      <div class="lms-movie__availability">
        {%- if movie_available -%}
          <span class="lms-movie__stock lms-movie__stock--in"><span aria-hidden="true">● </span>{{ movie_label }}</span>
        {%- else -%}
          <span class="lms-movie__stock lms-movie__stock--out"><span aria-hidden="true">● </span>{{ movie_label }}</span>
        {%- endif -%}
      </div>

      <h1 class="lms-movie__title">{{ product.title }}</h1>

      {%- if product.description != blank -%}
        <div class="lms-movie__about">
          <span class="lms-eyebrow">About the film</span>
          <div class="lms-movie__description rte">{{ product.description }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.lms-movie { padding-block: 32px; }
.lms-movie__breadcrumb {
  font-family: var(--lms-font-mono);
  font-size: 13px;
  color: var(--lms-text-muted);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}
.lms-movie__breadcrumb a { color: inherit; text-decoration: none; }
.lms-movie__breadcrumb a:hover { color: var(--lms-text-strong); }
.lms-movie__grid {
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
  gap: 48px;
  align-items: start;
}
.lms-movie__media {
  aspect-ratio: 3 / 4;
  border-radius: var(--lms-radius-lg);
  overflow: hidden;
  border: var(--lms-border-width-strong) solid var(--lms-border-strong);
  box-shadow: var(--lms-shadow-lg);
}
.lms-movie__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.lms-movie__placeholder {
  width: 100%;
  height: 100%;
  background: var(--lms-brick);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 32px;
  position: relative;
}
.lms-movie__placeholder-title {
  font-family: var(--lms-font-display);
  font-weight: var(--lms-fw-head-semi);
  font-size: 34px;
  line-height: 1.08;
  color: var(--lms-text-on-brick);
}
.lms-movie__placeholder-caption {
  position: absolute;
  bottom: 14px;
  left: 0;
  right: 0;
  font-family: var(--lms-font-mono);
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255, 249, 239, 0.6);
}
.lms-movie__details { display: flex; flex-direction: column; gap: 16px; }
.lms-movie__chips { display: flex; gap: 8px; flex-wrap: wrap; }
.lms-movie__chips a { text-decoration: none; }
.lms-movie__availability {
  font-family: var(--lms-font-mono);
  font-size: 13px;
  letter-spacing: 0.02em;
}
.lms-movie__stock--in { color: var(--lms-sage); }
.lms-movie__stock--out { color: var(--lms-text-muted); }
.lms-movie__title {
  font-family: var(--lms-font-display);
  font-weight: var(--lms-fw-head-semi);
  font-size: 40px;
  line-height: 1.04;
  color: var(--lms-text-strong);
  margin: 0;
}
.lms-movie__about { margin-top: 8px; }
.lms-movie__about .lms-movie__description { margin-top: 10px; }
.lms-movie__description { color: var(--lms-text-body); }
@media (max-width: 749px) {
  .lms-movie__grid { grid-template-columns: 1fr; gap: 24px; }
  .lms-movie__title { font-size: 30px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Movie details",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Movie details" }]
}
{% endschema %}
