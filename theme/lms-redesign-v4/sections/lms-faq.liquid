{% comment %}
  lms-faq — centered eyebrow/heading, then a stack of native <details>
  accordion CATEGORIES. Each "category" block opens a new collapsible
  group; every "question" block after it renders inside that group as
  plain (non-collapsible) content until the next "category" block.
  No JS: <details>/<summary> gives free keyboard + screen-reader support.
{% endcomment %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
<div class="lms-faq color-custom-{{ section.id }}"
  style="--lms-pad-top: {{ section.settings.padding-block-start }}px; --lms-pad-bottom: {{ section.settings.padding-block-end }}px;"
  {{ section.shopify_attributes }}>
  <div class="lms-container lms-container--narrow">
    <div class="lms-faq__header">
      {% render 'lms-eyebrow', text: section.settings.eyebrow %}
      {%- if section.settings.heading != blank -%}
        <h2 class="lms-faq__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="lms-faq__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lms-faq__list">
        {%- assign lms_faq_open = false -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'category' -%}
              {%- if lms_faq_open -%}</div></details>{%- endif -%}
              {%- if block.settings.background_color != blank -%}
                {%- render 'contrast-override', background_color: block.settings.background_color, section_id: block.id -%}
              {%- endif -%}
              <details class="lms-faq__category{% if block.settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}" {{ block.shopify_attributes }}>
                <summary class="lms-faq__category-title">
                  <span>{{ block.settings.title }}</span>
                  <span class="lms-faq__icon" aria-hidden="true"></span>
                </summary>
                <div class="lms-faq__category-body">
              {%- assign lms_faq_open = true -%}
            {%- when 'question' -%}
              <div class="lms-faq__qa" {{ block.shopify_attributes }}>
                <p class="lms-faq__q">{{ block.settings.question }}</p>
                <div class="lms-faq__a rte">{{ block.settings.answer }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
        {%- if lms_faq_open -%}</div></details>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.lms-faq {
  background: var(--lms-bg, var(--lms-parchment));
  padding-block: var(--lms-pad-top, 72px) var(--lms-pad-bottom, 72px);
}
.lms-container--narrow {
  max-width: 720px;
}
.lms-faq__header {
  text-align: center;
  margin: 0 auto 40px;
}
.lms-faq .lms-eyebrow { display: block; }
.lms-faq__heading {
  font-family: var(--lms-font-display);
  font-weight: var(--lms-fw-head-med);
  font-size: 34px;
  line-height: var(--lms-lh-tight);
  color: var(--lms-text-strong);
  margin: 12px 0 0;
}
.lms-faq__subheading {
  font-family: var(--lms-font-mono);
  font-weight: var(--lms-fw-mono-light);
  font-size: 15px;
  line-height: 1.6;
  color: var(--lms-text-muted);
  margin: 12px 0 0;
}
.lms-faq__list {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.lms-faq__category {
  border: var(--lms-border-width) solid var(--color-border, var(--lms-border-default));
  border-radius: var(--lms-radius-lg);
  background: var(--color-background, var(--lms-bg));
  padding: 6px 32px;
}
.lms-faq__category-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 26px 0;
  font-family: var(--lms-font-display);
  font-weight: var(--lms-fw-head-med);
  font-size: 21px;
  color: var(--color-foreground, var(--lms-text-strong));
  cursor: pointer;
  list-style: none;
}
.lms-faq__category-title::-webkit-details-marker { display: none; }
.lms-faq__icon {
  position: relative;
  flex-shrink: 0;
  width: 22px;
  height: 22px;
}
.lms-faq__icon::before,
.lms-faq__icon::after {
  content: "";
  position: absolute;
  background: var(--color-foreground, var(--lms-brick));
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.lms-faq__icon::before { width: 100%; height: 2px; }
.lms-faq__icon::after {
  width: 2px;
  height: 100%;
  transition: transform 0.15s ease;
}
.lms-faq__category[open] .lms-faq__icon::after { transform: translate(-50%, -50%) scaleY(0); }
.lms-faq__category-body {
  display: flex;
  flex-direction: column;
  padding: 0 0 28px;
}
.lms-faq__qa {
  padding: 18px 0;
  border-top: var(--lms-border-width) solid var(--color-border, var(--lms-border-default));
}
.lms-faq__qa:first-child { border-top: none; }
.lms-faq__q {
  margin: 0 0 6px;
  font-family: var(--lms-font-display);
  font-weight: var(--lms-fw-head-med);
  font-size: 17px;
  color: var(--color-foreground, var(--lms-text-strong));
}
.lms-faq__a {
  font-family: var(--lms-font-mono);
  font-weight: var(--lms-fw-mono-light);
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-foreground-muted, var(--lms-text-muted));
}
.lms-faq__a p { margin: 0 0 0.75em; }
.lms-faq__a p:last-child { margin-bottom: 0; }
.lms-faq__a ul,
.lms-faq__a ol { margin: 0 0 0.75em; padding-left: 1.25em; }
.lms-faq__a li { margin: 0 0 0.25em; }

@media screen and (max-width: 549px) {
  .lms-faq__category { padding: 6px 22px; }
  .lms-faq__category-title { font-size: 18px; padding: 20px 0; }
  .lms-faq__q { font-size: 16px; }
  .lms-faq__a { font-size: 14px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LMS FAQ",
  "tag": "section",
  "class": "lms-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you probably want to know before you walk in, plus a few things you didn't ask."
    },
    { "type": "header", "content": "Section style" },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Category title"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "t:settings.background_color",
          "placeholder": "t:settings.default"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "LMS FAQ",
      "blocks": [
        { "type": "category" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
